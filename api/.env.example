# Copie para api/.env e ajuste. Este arquivo vai para o repositório; o .env não.
#
# A lista abaixo é a mesma que src/config/ambiente.ts valida no boot: se faltar
# alguma obrigatória, a API não sobe e diz exatamente qual.

# Obrigatórias ---------------------------------------------------------------
DATABASE_URL="postgresql://pad:pad@localhost:5432/pad?schema=public"
JWT_SECRET="troque-por-um-segredo-de-no-minimo-16-caracteres"

# Opcionais (o valor abaixo é o padrão aplicado quando ausente) ---------------
JWT_EXPIRES_IN="1h"
SALA_TOKEN_TTL_SEG=900
API_PORT=3000
CORS_ORIGIN="http://localhost:5173"
NODE_ENV=development
