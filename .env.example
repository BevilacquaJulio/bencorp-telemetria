# =============================================================================
# PAD — variáveis do ambiente Docker
# Copie para .env antes de executar `docker compose up -d --build`.
# O arquivo .env contém segredos e nunca deve ser versionado.
# =============================================================================

# PostgreSQL ------------------------------------------------------------------
POSTGRES_USER=pad
POSTGRES_PASSWORD=pad
POSTGRES_DB=pad
POSTGRES_PORT=5432
DATABASE_URL=postgresql://pad:pad@db:5432/pad?schema=public

# Autenticação ----------------------------------------------------------------
# Use um valor aleatório e longo fora do ambiente local.
JWT_SECRET=troque-este-valor-por-um-segredo-com-pelo-menos-32-caracteres
JWT_EXPIRES_IN=1h

# Sala de vídeo ---------------------------------------------------------------
# O TTL máximo aceito pela API é 900 segundos, conforme o case.
SALA_TOKEN_TTL_SEG=900
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecretdevsecretdevsecret32chr

# Valores seguros para duas sessões no mesmo computador. O NODE_IP é o endereço
# anunciado nos candidatos ICE e nunca deve ser o IP interno do container.
LIVEKIT_PUBLIC_URL=ws://localhost:7880
LIVEKIT_NODE_IP=127.0.0.1
LIVEKIT_PORT=7880
LIVEKIT_TCP_PORT=7881
LIVEKIT_UDP_PORT=7882

# Portas públicas -------------------------------------------------------------
API_PORT=3000
WEB_PORT=8080
CORS_ORIGIN=http://localhost:8080

# Origem usada nos convites compartilhados. Vazio usa a origem aberta no
# navegador. Em uma implantação pública, informe https://pad.seudominio.com.br.
APP_PUBLIC_URL=
