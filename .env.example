# =============================================================================
# PAD — variáveis de ambiente
# Copie para .env e ajuste. O .env nunca vai para o repositório.
# =============================================================================

# --- Banco -------------------------------------------------------------------
POSTGRES_USER=pad
POSTGRES_PASSWORD=pad
POSTGRES_DB=pad

# Porta no host. Se já houver um PostgreSQL instalado na máquina ocupando a
# 5432, troque para 5433 aqui e também no DATABASE_URL de api/.env.
POSTGRES_PORT=5432

# Usado pelos containers: o host é o nome do serviço no compose.
# Para rodar o Prisma da sua máquina, use api/.env com host localhost.
DATABASE_URL=postgresql://pad:pad@db:5432/pad?schema=public

# --- Autenticação --------------------------------------------------------------
JWT_SECRET=troque-este-valor-em-producao
JWT_EXPIRES_IN=1h

# --- Sala de vídeo -------------------------------------------------------------
# TTL do token de sala em segundos. O requisito é no máximo 15 minutos.
SALA_TOKEN_TTL_SEG=900

LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecretdevsecretdevsecret32chr

# --- API -----------------------------------------------------------------------
API_PORT=3000
NODE_ENV=development

# --- Frontend --------------------------------------------------------------------
VITE_API_URL=http://localhost:3000
