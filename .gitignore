# =============================================================================
# PAD — Pronto Atendimento Digital
# NestJS + Prisma + PostgreSQL · React + Vite + PWA · Docker · Windows
# =============================================================================

# --- Notas pessoais ----------------------------------------------------------
# Planejamento e rascunhos que não fazem parte da entrega.
_notas/

# --- Segredos ----------------------------------------------------------------
# As duas primeiras linhas são necessárias: `.env.*` NÃO casa com `.env`.
# As negações vêm depois das regras, senão não têm efeito.
.env
.env.*
!.env.example
!.env.*.example

# --- Dependências ------------------------------------------------------------
node_modules/

# --- Build -------------------------------------------------------------------
dist/
dist-ssr/
build/
*.tsbuildinfo

# --- Cache -------------------------------------------------------------------
.vite/
.cache/
*.local

# --- Vite PWA ----------------------------------------------------------------
# Service worker gerado em modo de desenvolvimento.
web/dev-dist/

# --- Logs --------------------------------------------------------------------
*.log
logs/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# --- Testes ------------------------------------------------------------------
coverage/
.nyc_output/

# --- Docker ------------------------------------------------------------------
docker-compose.override.yml
*.pid

# --- Banco de dados ----------------------------------------------------------
# Dump contém dado real de paciente. Nunca versionar.
# Atenção: `api/prisma/migrations/` DEVE ser versionado — é a história do schema.
*.sql.gz
*.dump
*.sqlite
*.sqlite3
*.db
*.db-journal

# --- Sistema operacional (Windows + OneDrive geram estes sozinhos) -----------
Desktop.ini
Thumbs.db
ehthumbs.db
$RECYCLE.BIN/
.DS_Store
._*
*~

# --- Editores ----------------------------------------------------------------
.idea/
*.iml
.vscode/*
!.vscode/extensions.json
*.swp
*.swo
*.bak
*.orig

# =============================================================================
# Propositalmente NÃO ignorados
# =============================================================================
# .cursor/rules/        → regras do projeto, versionadas de propósito
# package-lock.json     → garante build reproduzível
# api/prisma/migrations → histórico versionado do schema
# .env.example          → contrato das variáveis de ambiente
